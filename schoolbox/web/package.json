{
	"name": "@schoolbox/web",
	"version": "0.1.0",
	"private": true,
	"description": "Oberfläche der Schoolbox (React/Vite)",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test \"src/**/*.test.ts\"",
		"test:alles": "SCHOOLBOX_TESTS=alles tsx --test --test-concurrency=2 \"src/**/*.test.ts\"",
		"e2e": "pnpm run build && playwright test",
		"hilfe:bilder": "pnpm run build && playwright test -c playwright.hilfe.config.ts",
		"video": "pnpm run build && playwright test -c playwright.video.config.ts",
		"e2e:browser": "PLAYWRIGHT_SKIP_BROWSER_GC=1 playwright install webkit chromium"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@floating-ui/react": "^0.27.20",
		"@fontsource-variable/inter": "^5.3.0",
		"lucide-react": "^1.68.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "^7.18.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@schoolbox/kern": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^5.0.0",
		"tailwindcss": "^4.3.3",
		"vite": "^7.0.0"
	}
}
