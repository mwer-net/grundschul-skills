{
	"name": "schoolbox",
	"private": true,
	"description": "Schoolbox: Web-Anwendung für Grundschulmaterial aus den Skills",
	"packageManager": "pnpm@10.15.1",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm -r run test",
		"prettier:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json}\"",
		"prettier:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json}\"",
		"eslint:check": "eslint \"**/*.{js,mjs,cjs,ts,tsx}\"",
		"eslint:fix": "eslint \"**/*.{js,mjs,cjs,ts,tsx}\" --fix",
		"format": "pnpm run prettier:fix && pnpm run eslint:fix",
		"lint": "pnpm run prettier:check && pnpm run eslint:check"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^22.20.5",
		"@typescript-eslint/parser": "^8.71.1",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-sort-destructure-keys": "^2.0.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.9",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"unrs-resolver"
		]
	}
}
