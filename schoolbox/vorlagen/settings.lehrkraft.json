			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git reset *)",
			"Bash(git checkout *)",
			"Bash(git switch *)",
			"Bash(git restore *)",
			"Bash(git merge *)",
			"Bash(git pull *)",
			"Bash(git rebase *)",
			"Bash(git stash *)",
			"Bash(git clean *)",
			"Bash(git remote *)",
