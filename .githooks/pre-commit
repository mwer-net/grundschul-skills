#!/usr/bin/env bash
# Netz unter .gitignore: Das Repo ist öffentlich. Materialien, .env und lokal/ dürfen nie in einen Commit,
# auch nicht per `git add -f`. Aktivieren mit: git config core.hooksPath .githooks
set -euo pipefail

wurzel=$(git rev-parse --show-toplevel)

# Setzt scripts/einrichten-lehrkraft.sh: Im Klon der Lehrkraft entsteht kein Commit, auch nicht versehentlich
if [ "$(git config --type=bool --default false --get schoolbox.lehrkraftModus)" = true ]; then
	echo "Commit abgebrochen: Dieser Klon ist im Lehrkraft-Modus, hier wird nicht committet." >&2
	echo "Änderungen entstehen im Entwicklerklon und kommen mit scripts/ausrollen.sh hierher." >&2
	exit 1
fi

env_wert() {
	[ -f "$wurzel/.env" ] || return 0
	sed -n "s/^$1=//p" "$wurzel/.env" | tail -n 1 | sed -e 's/^["'\'']//' -e 's/["'\'']$//'
}

gesperrt=(materialien lokal)
material_dir=$(env_wert MATERIAL_DIR)
case "$material_dir" in
	"$wurzel"/*) material_dir=${material_dir#"$wurzel"/} ;;
	/*) material_dir= ;;
esac
material_dir=${material_dir#./}
material_dir=${material_dir%/}
[ -n "$material_dir" ] && gesperrt+=("$material_dir")

fehler=()
while IFS= read -r -d '' pfad; do
	for ordner in "${gesperrt[@]}"; do
		# Der Name allein ist ein Symlink auf den Ordner: Sein Ziel (ein Pfad dieses Rechners) stünde im Commit
		case "$pfad" in "$ordner" | "$ordner"/*) fehler+=("$pfad") ;; esac
	done
	name=${pfad##*/}
	case "$name" in
		.env.example) ;;
		.env | .env.*) fehler+=("$pfad") ;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ ${#fehler[@]} -gt 0 ]; then
	echo "Commit abgebrochen: Diese Dateien dürfen nicht ins öffentliche Repo:" >&2
	printf '  %s\n' "${fehler[@]}" | sort -u >&2
	echo "Entfernen mit: git restore --staged <pfad>" >&2
	exit 1
fi

# Erzeugte Tabellen in den Skills müssen zu ihrer Quelle passen. Fehlt tsx (frischer Klon), prüft spätestens ausrollen.sh
if git diff --cached --name-only | grep -qE '^(skills/|schoolbox/kern/src/)' && [ -x "$wurzel/schoolbox/node_modules/.bin/tsx" ]; then
	if ! "$wurzel/schoolbox/node_modules/.bin/tsx" "$wurzel/schoolbox/kern/src/quellen.ts" --pruefen; then
		echo 'Commit abgebrochen: In schoolbox/ „pnpm run quellen“ ausführen und die Dateien hinzufügen.' >&2
		exit 1
	fi
fi

url=$(env_wert SCHOOLBOX_URL)
domain=${url#*://}
domain=${domain%%/*}
domain=${domain%%:*}
if [ -n "$domain" ] && git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -qiF "$domain"; then
	echo "Warnung: Der Diff enthält die Domain $domain. Bitte prüfen (git diff --cached)." >&2
fi

exit 0
