# Konfiguration der Schoolbox. Kopieren nach .env (wird nie committet) und anpassen.

# Öffentliche Adresse, unter der die Schoolbox erreichbar ist (für Links aus dem CLI)
SCHOOLBOX_URL=https://schoolbox.example.org

# Ablage der Materialien, relativ zum Repo-Hauptordner oder absolut
MATERIAL_DIR=./materialien

# Node 22 mit absolutem Pfad, falls im PATH ein älteres Node liegt (z. B. ~/.nvm/versions/node/v22.x.y/bin/node)
NODE_BIN=

# Python für blatt.py (mit venv: .venv/bin/python)
PYTHON_BIN=python3

# Server: lauscht nur lokal, ein Reverse Proxy (z. B. Apache) leitet die öffentliche Adresse hierher
HOST=127.0.0.1
PORT=4009

# Anmeldung (Pflicht): „schoolbox/bin/schoolbox passwort“ setzt den Hash und, falls leer, ein zufälliges Geheimnis
# (sonst z. B. openssl rand -hex 32). Ein neues Geheimnis oder Passwort meldet alle Geräte ab.
PASSWORT_HASH=
SITZUNG_GEHEIMNIS=

# Mail für die Überwachung (optional)
MAIL_AN=
MAIL_VON=
MAIL_RESEND_API_KEY=
